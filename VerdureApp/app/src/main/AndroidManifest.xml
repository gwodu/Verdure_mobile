<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Calendar permissions for reading events -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Voice typing (on-device Whisper dictation across all apps) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Exempts the mic foreground service from Android 14's background-start
         restriction so dictation can begin from the floating overlay. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- App Priority Settings Activity -->
        <activity
            android:name=".ui.AppPriorityActivity"
            android:exported="false"
            android:label="App Priority"
            android:parentActivityName=".ui.MainActivity"/>

        <!-- Incentives/Goals Tracking Activity -->
        <activity
            android:name=".ui.IncentivesActivity"
            android:exported="false"
            android:label="Incentives"
            android:parentActivityName=".ui.MainActivity"/>

        <!-- Voice typing setup (mic + accessibility + Whisper download) -->
        <activity
            android:name=".ui.VoiceSettingsActivity"
            android:exported="false"
            android:label="Voice Typing"
            android:parentActivityName=".ui.MainActivity"/>

        <!-- Plain text fields for verifying dictation (user sanity check + CI e2e) -->
        <activity
            android:name=".ui.DictationTestActivity"
            android:exported="true"
            android:label="Voice Typing Test"
            android:parentActivityName=".ui.VoiceSettingsActivity"/>


        <!-- NotificationListenerService for capturing notifications -->
        <service
            android:name=".services.VerdureNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Background service for automatic LLM summarization -->
        <service
            android:name=".services.NotificationSummarizationService"
            android:enabled="true"
            android:exported="false" />

        <!-- Accessibility service: floating mic overlay + text injection across apps -->
        <service
            android:name=".services.VoiceInputAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/voice_accessibility_service" />
        </service>

        <!-- Microphone foreground service: records + runs Whisper during dictation -->
        <service
            android:name=".services.DictationForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Widget provider for home screen widget -->
        <receiver
            android:name=".widget.VerdureWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.verdure.widget.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/verdure_widget_info" />
        </receiver>

        <!-- Boot receiver to start services after device restart -->
        <receiver
            android:name=".receivers.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
